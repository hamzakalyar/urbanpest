# UrbanPest — Apache Rewrite Rules (Optional)
# Enable clean URLs: /services/rodent-control → services-single.php?slug=rodent-control

RewriteEngine On
RewriteBase /

# Services clean URLs
RewriteRule ^services/?$ /services.php [L]
RewriteRule ^services/([a-z0-9-]+)/?$ /services-single.php?slug=$1 [L,QSA]

# Industries clean URLs
RewriteRule ^industries/?$ /industries.php [L]
RewriteRule ^industries/([a-z0-9-]+)/?$ /industries-single.php?slug=$1 [L,QSA]

# About clean URLs
RewriteRule ^about/?$ /about.php [L]
RewriteRule ^about/sustainability/?$ /about-sustainability.php [L]
RewriteRule ^about/innovation/?$ /about-innovation.php [L]
RewriteRule ^about/locations/?$ /about-locations.php [L]
RewriteRule ^about/careers/?$ /about-careers.php [L]

# Insights clean URLs
RewriteRule ^insights/?$ /insights.php [L,QSA]
RewriteRule ^insights/([a-z0-9-]+)/?$ /insights-single.php?slug=$1 [L,QSA]

# Contact
RewriteRule ^contact/?$ /contact.php [L]

# Book Service
RewriteRule ^book/?$ /book.php [L,QSA]

# Admin
RewriteRule ^admin/?$ /admin/index.php [L]

# Prevent directory browsing
Options -Indexes

# Block access to sensitive data files, logs, and hidden dotfiles
<FilesMatch "\.(json|txt|log|ini|env|sql|bak|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Defensive Security Headers
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>
